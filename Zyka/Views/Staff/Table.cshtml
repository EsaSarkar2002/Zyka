@model IEnumerable<Zyka.Models.Entities.TableInfo>
@using Zyka.Models.Enums
@{
    ViewData["Title"] = "Table Management";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}
 
<head>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/StaffBooking.css">
<script src="~/js/site-clock.js"></script>
</head>
 
<main class="main-content">
<div class="top-bar">
<div class="page-title">
<h2>Table Management</h2>
<p>Live status for @ViewBag.SelectedDate</p>
</div>
 
        <div class="top-bar-right">
<form method="get" asp-action="Table" class="d-flex align-items-center me-3">
<input type="date" name="filterDate" class="form-control form-control-sm" 
                       value="@ViewBag.SelectedDate" onchange="this.form.submit()">
</form>
 
            <div class="datetime-display">
<p class="time" id="currentTime">@DateTime.Now.ToString("HH:mm:ss")</p>
<p class="date">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
</div>
</div>
</div>
 
    <div class="content-section active p-4">
<div class="container-fluid">
<div class="row g-4 mt-2">
                @foreach (var table in Model)
                {
                    string cardClass = table.Status == TableStatus.Available ? "status-available" : "status-reserved";
                    DateTime selectedDate = DateTime.Parse(ViewBag.SelectedDate);
 
                    // LOGIC: Count how many active reservations are booked for THIS table on THIS date
                    var bookingCount = table.Reservations.Count(r => 
                        r.ReservationDate.Date == selectedDate.Date && 
                        r.Status != ReservationStatus.Cancelled && 
                        r.Status != ReservationStatus.Completed);
 
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
<div class="table-card @cardClass">
<div class="table-header">
<i class="bi bi-grid-3x3-gap"></i>
<h4 class="mb-0">Table @table.TableNumber</h4>
</div>
<p class="seats-info text-muted mb-2">
<i class="bi bi-tag"></i> @table.Category
</p>
 
                            @* DISPLAY THE COUNT OF CUSTOMER BOOKINGS *@
<div class="booking-info mt-2 mb-3">
                                @if (bookingCount > 0)
                                {
<div class="p-2 rounded bg-primary bg-opacity-10 border border-primary border-opacity-25">
<p class="mb-0 text-primary fw-bold small">
<i class="bi bi-journal-bookmark-fill"></i> 
                                            Bookings Today: <span class="fs-6">@bookingCount</span>
</p>
</div>
                                }
                                else
                                {
<div class="p-2 rounded bg-success bg-opacity-10">
<p class="mb-0 text-success small">
<i class="bi bi-check-circle-fill"></i> No Bookings
</p>
</div>
                                }
</div>
<div class="status-badge @table.Status.ToString().ToLower()">
<span>@table.Status</span>
</div>
</div>
</div>
                }
</div>
</div>
</div>
</main>
 