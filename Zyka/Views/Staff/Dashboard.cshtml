@{
    ViewData["Title"] = "Dashboard page";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}
 
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@ViewData["Title"] - Staff Portal</title>
<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<!-- Custom CSS -->
<link rel="stylesheet" href="~/css/StaffBooking.css">
</head>
 
<!-- Main Content -->
<main class="main-content">
<div class="top-bar">
<div class="page-title">
<h2 id="pageTitle">Dashboard</h2>
<p id="pageSubtitle">Welcome back! Here's your overview</p>
</div>
 
        <div class="top-bar-right">
<div class="datetime-display">
<p class="time" id="currentTime">13:56:44</p>
<p class="date" id="currentDate">Tuesday, January 6, 2026</p>
</div>
 
            <div class="staff-info">
<div class="staff-avatar" id="staffAvatar">S</div>
<div>
<p class="staff-name" id="staffName">Staff Member</p>
<p class="staff-role">Staff</p>
</div>
</div>
</div>
</div>
 
    <!-- Dashboard Section -->
<section id="dashboard-section" class="content-section active container-fluid">
<!-- KPI Cards -->
<div class="row mb-4">
<div class="col-lg-3 col-md-6 mb-3">
<div class="kpi-card primary">
<div class="icon-wrapper">
<i class="bi bi-grid-3x3-gap"></i>
</div>
<p class="label">Total Tables</p>
<h3 class="value" id="totalTables">24</h3>
<p class="change">Restaurant capacity</p>
</div>
</div>
 
            <div class="col-lg-3 col-md-6 mb-3">
<div class="kpi-card success">
<div class="icon-wrapper">
<i class="bi bi-check-circle"></i>
</div>
<p class="label">Available Tables</p>
<h3 class="value" id="availableTables">16</h3>
<p class="change positive"><i class="bi bi-arrow-up"></i> Ready for booking</p>
</div>
</div>
 
            <div class="col-lg-3 col-md-6 mb-3">
<div class="kpi-card warning">
<div class="icon-wrapper">
<i class="bi bi-calendar-event"></i>
</div>
<p class="label">Today's Bookings</p>
<h3 class="value" id="todayBookings">18</h3>
<p class="change"><i class="bi bi-clock"></i> 8 upcoming</p>
</div>
</div>
 
            <div class="col-lg-3 col-md-6 mb-3">
<div class="kpi-card info">
<div class="icon-wrapper">
<i class="bi bi-people"></i>
</div>
<p class="label">Guests Today</p>
<h3 class="value" id="guestsToday">72</h3>
<p class="change positive"><i class="bi bi-arrow-up"></i> +12% vs yesterday</p>
</div>
</div>
</div>
 
        <div class="row">
<!-- Alerts -->
<div class="col-lg-4 mb-4">
<div class="alert-card">
<h5><i class="bi bi-exclamation-triangle"></i> Alerts &amp; Notifications</h5>
<div id="alertsList">
<div class="alert-item">
<div>
<strong>Table 4</strong>
<p class="mb-0">Reserved at 2:00 PM</p>
</div>
<span class="alert-badge soon">In 30 min</span>
</div>
<div class="alert-item">
<div>
<strong>Table 12</strong>
<p class="mb-0">Occupied since 12:30 PM</p>
</div>
<span class="alert-badge overdue">Overdue</span>
</div>
<div class="alert-item">
<div>
<strong>Table 7</strong>
<p class="mb-0">Reserved at 6:30 PM</p>
</div>
<span class="alert-badge soon">In 2 hours</span>
</div>
</div>
</div>
</div>
 
            <!-- Ongoing & Upcoming Reservations -->
<div class="col-lg-8 mb-4">
<div class="reservation-card">
<h5><i class="bi bi-clock-history"></i> Ongoing &amp; Upcoming Reservations</h5>
<div id="reservationsList">
<!-- Reservation items here -->
</div>
</div>
</div>
</div>
</section>
</main>
``
</html>