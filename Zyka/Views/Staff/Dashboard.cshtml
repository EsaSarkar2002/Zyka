@using Zyka.Models.Enums
@model IEnumerable<Zyka.Models.Reservation>
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}
 
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/StaffBooking.css">
<script src="~/js/site-clock.js"></script>
 
<div class="container-fluid p-4">
<div class="d-flex justify-content-between align-items-center mb-4">
<div>
<h2 class="fw-bold">Dashboard</h2>
<p class="text-muted">Welcome back! Here's your overview</p>
</div>
<div class="text-end">
<h4 class="mb-0 fw-bold" id="liveClock">@DateTime.Now.ToString("HH:mm:ss")</h4>
<p class="text-muted mb-0">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
</div>
</div>
 
    <div class="row g-4 mb-5">
<div class="col-md-3">
<div class="card kpi-card shadow-sm p-4 text-center">
<i class="bi bi-grid-3x3-gap text-primary fs-1 mb-2"></i>
<h6 class="text-muted">Total Tables</h6>
<h2 class="fw-bold">@ViewBag.TotalTables</h2>
</div>
</div>
<div class="col-md-3">
<div class="card kpi-card shadow-sm p-4 text-center">
<i class="bi bi-check-circle text-success fs-1 mb-2"></i>
<h6 class="text-muted">Available Tables</h6>
<h2 class="fw-bold">@ViewBag.AvailableTables</h2>
</div>
</div>
<div class="col-md-3">
<div class="card kpi-card shadow-sm p-4 text-center">
<i class="bi bi-calendar-check text-warning fs-1 mb-2"></i>
<h6 class="text-muted">Today's Bookings</h6>
<h2 class="fw-bold">@ViewBag.TodayBookingsCount</h2>
</div>
</div>
<div class="col-md-3">
<div class="card kpi-card shadow-sm p-4 text-center">
<i class="bi bi-people text-info fs-1 mb-2"></i>
<h6 class="text-muted">Guests Today</h6>
<h2 class="fw-bold">@ViewBag.GuestsToday</h2>
</div>
</div>
</div>
 
    <div class="row">
<div class="col-lg-12">
<div class="card border-0 shadow-sm p-4">
<h5 class="fw-bold mb-4">Ongoing & Upcoming Reservations</h5>
<div class="table-responsive">
<table class="table align-middle">
<thead class="table-light">
<tr>
<th>Customer</th>
<th>Table</th>
<th>Slot</th>
<th>Status</th>
</tr>
</thead>
<tbody>
                            @foreach (var res in Model)
                            {
<tr>
<td><strong>@res.FullName</strong></td>
<td>
                                        @* UPDATED: Using TableNumber instead of TableId *@
<span class="badge bg-light text-dark border">
                                            Table @(res.Table != null ? res.Table.TableNumber : res.TableId.ToString())
</span>
</td>
<td>
                                        @* UPDATED: Using DisplayText for better readability *@
<small class="text-primary fw-bold">
<i class="bi bi-clock me-1"></i>
                                            @(res.TimeSlot != null ? res.TimeSlot.DisplayText : "N/A")
</small>
</td>
<td>
<span class="status-badge @res.Status.ToString().ToLower()">@res.Status</span>
</td>
</tr>
                            }
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
