@{

    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}
<div class="admin-content">
<div class="mb-4 top-bar d-flex">
<div class="top-bar-left">
<h1 class="text-dark-green">Dashboard Overview</h1>
<p class="text-muted">Welcome back! Here's your restaurant summary.</p>
</div>
 
        <div class="top-bar-right">
<div class="datetime-display text-end">
<p class="time fw-bold" id="currentTime">@DateTime.Now.ToString("HH:mm:ss")</p>
<p class="date text-muted" id="currentDate">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
</div>
</div>
</div>
 
        <!-- Stats Cards -->
<div class="row g-4 mb-4">
<div class="col-md-6 col-lg-3">
<div class="card stat-card">
<div class="stat-icon bg-opacity-10">
<i class="bi bi-grid-3x3 text-warning fs-2"></i>
</div>
<h6 class="text-muted mt-3">Total Tables</h6>
<p class="stat-value text-warning" id="totalTables">@ViewBag.TotalTables</p>
</div>
</div>
<div class="col-md-6 col-lg-3">
<div class="card stat-card">
<div class="stat-icon">
<i class="bi bi-calendar-check text-dark-green fs-2"></i>
</div>
<h6 class="text-muted mt-3">Today's Bookings</h6>
<p class="stat-value text-dark-green" id="todayBookings">@ViewBag.TadaysReservations</p>
</div>
</div>
<div class="col-md-6 col-lg-3">
<div class="card stat-card">
<div class="stat-icon">
<i class="bi bi-calendar-check text-dark-green fs-2"></i>
</div>
<h6 class="text-muted mt-3">Today's Bookings</h6>
<p class="stat-value text-dark-green" id="todayBookings">@ViewBag.TadaysReservations</p>
</div>
</div>
<div class="col-md-6 col-lg-3">
<div class="card stat-card">
<div class="stat-icon">
<i class="bi bi-calendar-check text-dark-green fs-2"></i>
</div>
<h6 class="text-muted mt-3">Today's Bookings</h6>
<p class="stat-value text-dark-green" id="todayBookings">@ViewBag.TadaysReservations</p>
</div>
</div>
<div class="col-md-6 col-lg-3">
<div class="card stat-card">
<div class="stat-icon">
<i class="bi bi-calendar-check text-dark-green fs-2"></i>
</div>
<h6 class="text-muted mt-3">Today's Bookings</h6>
<p class="stat-value text-dark-green" id="todayBookings">@ViewBag.TadaysReservations</p>
</div>
</div>
<div class="col-md-6 col-lg-3">
<div class="card stat-card">
<div class="stat-icon bg-opacity-10">
<i class="bi bi-clock text-primary fs-2"></i>
</div>
<h6 class="text-muted mt-3">Upcoming Bookings</h6>
<p class="stat-value text-primary" id="upcomingBookings">@ViewBag.UpcomingReservations</p>
</div>
</div>
<div class="col-md-6 col-lg-3">
<div class="card stat-card">
<div class="stat-icon bg-opacity-10">
<i class="bi bi-wrench text-danger fs-2"></i>
</div>
<h6 class="text-muted mt-3">Tables Under Maintenance</h6>
<p class="stat-value text-danger" id="maintenanceTables">@ViewBag.MaintenanceTablse</p>
</div>
</div>
</div>
 
        <!-- Quick Actions -->
<div class="card" style="background: linear-gradient(135deg, var(--beige) 0%, var(--cream) 100%); border: 1px solid rgba(212, 175, 55, 0.2);">
<div class="card-body">
<h3 class="text-dark-green mb-4">Quick Actions</h3>
<div class="row g-3">
<div class="col-md-4">
<a href="TableCategories"

						   class="btn btn-light w-100 py-3">View All Tables</a>
</div>
<div class="col-md-4">
<a href="Bookings" class="btn btn-light w-100 py-3">Check Bookings</a>
</div>
<div class="col-md-4">
<a href="History" class="btn btn-light w-100 py-3">View History</a>
</div>
</div>
</div>
</div>
</div>
 
    @section Scripts

    {<script src="~/js/site-clock.js"></script>}
 