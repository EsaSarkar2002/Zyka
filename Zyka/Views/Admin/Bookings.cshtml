@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@* <pre>
    @System.Text.Json.JsonSerializer.Serialize(ViewBag.Bookings)
</pre> *@

<div class="admin-content">
    <div class="mb-4">
        <h1 class="text-dark-green">Bookings Management</h1>
        <p class="text-muted">View and manage restaurant bookings</p>
    </div>

    
<div class="d-flex gap-2 mb-4" role="group" aria-label="Bookings tabs">
  <button type="button" class="btn btn-outline-primary view-bookings active" id="todayTab">
    Today's Bookings
    <span class="badge bg-success ms-2" id="todayCount">0</span>
  </button>
  <button type="button" class="btn btn-outline-primary view-bookings" id="futureTab">
    Future Bookings
    <span class="badge bg-primary ms-2" id="futureCount">0</span>
  </button>
</div>


    <!-- Bookings Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="bg-beige">
                        <tr>
                            <th>Customer Name</th>
                            <th>Table Category</th>
                            <th>Table Number</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="bookingsTableBody">
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Loading bookings...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    
    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="card border-success border-2">
                <div class="card-body bg-success bg-opacity-10">
                    <h6 class="text-success">Confirmed</h6>
                    <p class="display-6 text-success mb-0" id="confirmedCount">0</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-danger border-2">
                <div class="card-body bg-danger bg-opacity-10">
                    <h6 class="text-danger">Cancelled</h6>
                    <p class="display-6 text-danger mb-0" id="cancelledCount">0</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js"></script>

    <script>
        
       document.addEventListener("DOMContentLoaded",function(){
           initBookings(
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Bookings))
        );

        
        loadToday(); // Default: today's bookings
       });


        document.getElementById("todayTab").addEventListener("click", function () {
            setActiveTab(this);
            loadToday();
        });

        document.getElementById("futureTab").addEventListener("click", function () {
            setActiveTab(this);
            loadFuture();
        });

        function setActiveTab(activeBtn) {
            document.querySelectorAll(".view-bookings").forEach(btn =>
                btn.classList.remove("active")
                // btn.classList.remove(".nav-link");
            );
            activeBtn.classList.add("active");
        }

        function loadToday() {
            const todayBookings = getTodayBookings();
            renderBookingsTable(todayBookings);
            updateCounts();
        }

        function loadFuture() {
            const futureBookings = getFutureBookings();
            renderBookingsTable(futureBookings);
            updateCounts();
        }

        function renderBookingsTable(bookings) {
            const tbody = document.getElementById("bookingsTableBody");

            if (bookings.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            No bookings found
                        </td>
                    </tr>`;
                return;
            }

            let html = "";

            bookings.forEach(b => {
                const badgeClass =
                    b.Status === "confirmed" ? "success" :
                    b.Status === "completed" ? "secondary" : "danger";

                html += `
                    <tr>
                        <td>${b.CustomerName}</td>
                        <td class="text-capitalize">${b.TableCategory}</td>
                        <td>${b.TableNumber}</td>
                        <td>${formatDateForTitle(b.Date)}</td>
                        <td>${b.Time}</td>
                        <td>
                            <span class="badge bg-${badgeClass} text-capitalize">
                                ${b.Status}
                            </span>
                        </td>
                    </tr>`;
            });

            tbody.innerHTML = html;
        }

        function updateCounts() 
        {
            document.getElementById("todayCount").innerText = getTodayBookings().length;
            document.getElementById("futureCount").innerText = getFutureBookings().length;

            document.getElementById("confirmedCount").innerText =
                ALL_BOOKINGS.filter(b => b.Status === "confirmed").length;

            document.getElementById("cancelledCount").innerText =
                ALL_BOOKINGS.filter(b => b.Status === "cancelled").length;
        }
    </script>
}