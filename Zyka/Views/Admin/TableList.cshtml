@model List<TableInfo>
    @using Zyka.Models.Enums;
    @{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }

    <div class="admin-content">


        <div class="d-flex align-items-center justify-content-between mb-4">
            <h1 class="text-dark-green">
                @ViewBag.Category Tables
            </h1>

            <a asp-action="TableCategories" asp-controller="Admin" class="btn btn-outline-secondary">
                ← Back
            </a>
        </div>


        <div class="row g-4">

            @if (Model != null && Model.Any())
            {
            foreach (var table in Model)
            {
            <div class="col-md-6 col-lg-4">
                <div class="card table-card p-3 shadow">

                    <i class="bi bi-grid-3x3-gap-fill fs-4 text-success"></i>
                    <div class="d-flex justify-content-evenly mb-3">
                        <div>
                            <small>Table Number</small>
                            <h5 class="mb-0">@table.TableNumber</h5>
                        </div>
                        <div class="vr"></div>
                        <div>
                            <small>Status</small>
                            <div>
                                @if(table.Status==TableStatus.Available)
                                {
                                <h5 class="mb-0 status-btn bg-success text-white">@table.Status</h5>
                                }
                                else if(table.Status==TableStatus.Reserved)
                                {
                                <h5 class="mb-0 status-btn bg-danger text-white">@table.Status</h5>
                                }
                                else if(table.Status==TableStatus.Maintenance)
                                {
                                <h5 class="mb-0 status-btn bg-warning">@table.Status</h5>
                                }
                            </div>
                        </div>

                    </div>
                    @if(table.Status==TableStatus.Available)
                    {

                    <div class="buttons">
                        <a asp-action="MarkMaintenance" asp-route-tableId="@table.TableId"
                            asp-route-category="@ViewBag.Category" class="status-change-button">Mark for Maintenance</a>
                        <a class="status-change-button">Reserve this table</a>
                    </div>
                    }
                    else if(table.Status==TableStatus.Maintenance)
                    {
                    <div class="buttons">
                        <a asp-action="MarkAvailable" asp-route-tableId="@table.TableId"
                            asp-route-category="@ViewBag.Category" class="status-change-button">Mark as Available</a>
                        <button class="status-change-button">Reserve this table</button>
                    </div>
                    }



                </div>

            </div>
            }
            }
            else
            {
            <div class="col-12">
                <div class="alert alert-info">
                    No tables found for this category.
                </div>
            </div>
            }
            
            <div class="col-md-6 col-lg-4">
                <div class="card table-card p-3 shadow">
                    ADD A Table
                </div>
            </div>

        </div>
        
    </div>