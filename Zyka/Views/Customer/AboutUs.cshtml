@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}

<div class="zyka-about-hero">
    <div class="container text-center text-white">
        <span class="text-uppercase tracking-widest fw-bold zyka-gold-text">Est. 1998</span>
        <h1 class="display-2 fw-bold">A Symphony of Spices</h1>
        <p class="lead italic">Defining the fine art of modern Indian dining</p>
    </div>
</div>

<div class="container py-5">
    <div class="row align-items-center mb-5 pb-lg-5">
        <div class="col-lg-6 mb-5 mb-lg-0">
            <h2 class="zyka-title-gold">The Zyka Philosophy</h2>
            <h3 class="text-white mb-4">Beyond Food. <br />An Awakening of Senses.</h3>
            <p class="zyka-prose">
                At Zyka, we believe that a meal is more than just sustenance; it is a ritual.
                Born from the ancient kitchens of the royal courts and refined by modern culinary
                techniques, our menu is a love letter to the heritage of India.
            </p>
            <p class="zyka-prose">
                We don't just source ingredients; we hunt for stories. From the saffron fields of
                Kashmir to the pepper plantations of Kerala, every element on your plate has been
                selected for its purity and soul.
            </p>
            <div class="mt-4">
                <a href="/Menu" class="btn zyka-btn-gold">Explore Our Menu</a>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="zyka-image-stack">
                <img src="~/images/Gallery Bg.jpg" alt="Zyka Ambience" class="img-main rounded-4 shadow-lg">
            </div>
        </div>
    </div>

    <div class="zyka-glass-container p-5 rounded-5 mb-5 text-white">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Our Three Pillars</h2>
            <div class="gold-divider mx-auto"></div>
        </div>
        <div class="row text-center g-4">
            <div class="col-md-4">
                <div class="zyka-pillar-card">
                    <div class="pillar-icon-box">01</div>
                    <h4>Heritage</h4>
                    <p>Preserving the 5,000-year-old secrets of the 'Vedas' through traditional slow-cooking methods.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="zyka-pillar-card">
                    <div class="pillar-icon-box">02</div>
                    <h4>Innovation</h4>
                    <p>Reimagining classic profiles with avant-garde textures and breathtaking presentation.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="zyka-pillar-card">
                    <div class="pillar-icon-box">03</div>
                    <h4>Purity</h4>
                    <p>Zero artificial colors. Zero compromise. Only cold-pressed oils and farm-to-table produce.</p>
                </div>
            </div>
        </div>
    </div>
</div>