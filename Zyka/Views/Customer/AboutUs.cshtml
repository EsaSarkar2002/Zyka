@{
    ViewData["Title"] = "AboutUs";
    Layout = "_Layout";
}

<div class="zyka-about-page">
    <section class="zyka-section bg-black zyka-hero">
        <div class="zyka-container">
            <h1 class="zyka-title-large text-white">About Us</h1>
        </div>
    </section>

    <section class="zyka-section zyka-content-white">
        <div class="zyka-container">
            <h2 class="zyka-heading">Get Ready for the Next Level at Zyka!</h2>
            <div class="zyka-description">
                <p class="text-white">Craving an unforgettable culinary experience with your gang? Since our inception, <strong>Zyka</strong> has been delighting food lovers with our one-of-a-kind dining adventure. With a menu boasting over 150+ signature dishes, including authentic tandoors and interactive live counters, we’re the perfect venue for any celebration — be it an office outing, a birthday bash, an anniversary, or a long-awaited reunion with friends.</p>

                <p class="text-white">Our team is here to ensure your special occasion is nothing short of magical! Whether you're a vegetarian, a meat lover, or looking for gluten-free options, our diverse menu features a global array of flavors with a focus on Indian, Pan-Asian, and Mediterranean cuisines.</p>

                <p class="text-white">Stay tuned—something new and exciting is on the horizon at Zyka. We can't wait to share it with you!</p>
            </div>
        </div>
    </section>

    <section class="zyka-section zyka-live-counters">
        <div class="zyka-container">
            <h2 class="zyka-heading-light">Live Counters: Customized Delights</h2>
            <p class="zyka-description-light">
                Experience the magic of Zyka’s live counters—our specialty that brings global dishes to life with a personal twist! At our live counters, choose your ingredients and watch as our skilled chefs prepare and deliver your customized dish, right to your table.
            </p>

            <div class="zyka-video-wrapper">
                <iframe src="https://www.youtube.com/embed/IMHndOv12W4?controls=0&rel=0&autoplay=1&mute=1&loop=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            </div>

            <p class="zyka-description-light" style="margin-top: 20px;">
                Craving pasta with extra garlic? Prefer your stir-fry with a specific spice level? You choose, and we’ll cook it exactly how you like it. Enjoy a personalized culinary experience like no other!
            </p>
        </div>
    </section>
</div>