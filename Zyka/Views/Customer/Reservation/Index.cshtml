@{
    ViewData["Title"] = "Book Your Table";
    Layout = "_Layout";
}



<div class="zyka-booking-page">
    <div class="container py-5">
        <div class="zyka-booking-header text-center mb-5">
            <h1 class="text-black fw-bold">Reserve Your Table</h1>
            <p class="text-black">Complete the form below to book your dining experience</p>
        </div>

        <form id="bookingForm" class="mx-auto zyka-form">

            <section class="zyka-booking-card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="zyka-section-title mb-4">
                        <i class="bi bi-calendar3"></i>
                        <h3>Select Booking Type</h3>
                    </div>

                    <div class="row g-3 justify-content-center">
                        <div class="col-6 col-md-3">
                            <div class="zyka-type-card" data-type="date" data-seats="2">
                                <div class="zyka-type-img">
                                    <img src="~/images/Image1.jpg" alt="Dating" />
                                </div>
                                <div class="zyka-type-info">
                                    <span class="fw-bold text-white d-block">Dating</span>
                                    <small class="text-white">2 seats</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="zyka-type-card" data-type="family" data-seats="4">
                                <div class="zyka-type-img">
                                    <img src="~/images/Image family.jpg" alt="Family" />
                                </div>
                                <div class="zyka-type-info">
                                    <span class="fw-bold text-white d-block">Family</span>
                                    <small class="text-white">4-6 seats</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="zyka-type-card" data-type="meeting" data-seats="8">
                                <div class="zyka-type-img">
                                    <img src="~/images/Image meeting.jpg" alt="Meeting" />
                                </div>
                                <div class="zyka-type-info">
                                    <span class="fw-bold text-white d-block">Meeting</span>
                                    <small class="text-white">8-12 seats</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="zyka-type-card" data-type="party" data-seats="15">
                                <div class="zyka-type-img">
                                    <img src="~/images/Image party.jpg" alt="Party" />
                                </div>
                                <div class="zyka-type-info">
                                    <span class="fw-bold text-white d-block">Party</span>
                                    <small class="text-white">15-20 seats</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="seatingSection" class="mt-4 text-center" style="display:none;">
                        <label class="form-label fw-bold">Number of Guests</label>
                        <input type="number" class="form-control mx-auto w-auto text-center" id="seatingCapacity" min="1" max="50">
                    </div>
                </div>
            </section>

            <section class="card zyka-booking-card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="zyka-section-title mb-3">
                        <i class="bi bi-calendar-event"></i>
                        <h3>Select Date</h3>
                    </div>
                    <input type="date" class="form-control zyka-input" id="bookingDate" required>
                </div>
            </section>

            <section class="card zyka-booking-card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="zyka-section-title mb-4">
                        <i class="bi bi-clock"></i>
                        <h3>Select Time Slot</h3>
                    </div>

                    <div class="zyka-time-group mb-4">
                        <h6 class="zyka-time-label">Morning</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="zyka-time-btn" data-time="10:00 AM">10:00 AM - 11:00 AM</button>
                            <button type="button" class="zyka-time-btn" data-time="11:00 AM">11:00 AM - 12:00 PM</button>
                        </div>
                    </div>

                    <div class="zyka-time-group mb-4">
                        <h6 class="zyka-time-label">Afternoon</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="zyka-time-btn" data-time="12:00 PM">12:00 PM - 1:00 PM</button>
                            <button type="button" class="zyka-time-btn" data-time="1:00 PM">1:00 PM - 2:00 PM</button>
                        </div>
                    </div>

                    <div class="zyka-time-group">
                        <h6 class="zyka-time-label">Evening</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="zyka-time-btn" data-time="6:00 PM">6:00 PM - 7:00 PM</button>
                            <button type="button" class="zyka-time-btn" data-time="7:00 PM">7:00 PM - 8:00 PM</button>
                        </div>
                    </div>
                </div>
            </section>

            <section class="card zyka-booking-card shadow-sm mb-5">
                <div class="card-body p-4">
                    <div class="zyka-section-title mb-4">
                        <i class="bi bi-person"></i>
                        <h3>Your Details</h3>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Full Name *</label>
                            <input type="text" class="form-control zyka-input" id="customerName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mobile Number *</label>
                            <input type="tel" class="form-control zyka-input" id="mobileNumber" maxlength="10" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">WhatsApp Number *</label>
                            <input type="tel" class="form-control zyka-input" id="whatsappNumber" maxlength="10" required>
                        </div>
                    </div>
                </div>
            </section>

            <button type="submit" class="btn zyka-btn-submit w-100 py-3 mb-5">
                Proceed to Payment <i class="bi bi-chevron-right ms-2"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Booking.js" asp-append-version="true"></script>
}