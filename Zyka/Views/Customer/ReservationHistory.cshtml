@model List<Zyka.ViewModels.BookingHistoryViewModel>
 
@{
    ViewData["Title"] = "ReservationHistory";
    Layout = "_Layout";
}
 
<link rel="stylesheet" href="~/css/reservation.css" />
 
<div class="zyka-reservation-page">
    <div class="zyka-bg-layer"></div>
 
    <div class="zyka-overlay">
        <div class="container">
 
            <div class="zyka-header text-center">
                <p class="text-white h3">Your Personal Booking History</p>
            </div>
 
            <nav class="zyka-filter-nav d-flex justify-content-center flex-wrap gap-2 mb-5">
                <button class="btn zyka-filter-btn active" data-filter="all">All Bookings</button>
                <button class="btn zyka-filter-btn" data-filter="date">❤️ Date</button>
                <button class="btn zyka-filter-btn" data-filter="family">👨‍👩‍👧 Family</button>
                <button class="btn zyka-filter-btn" data-filter="meeting">💼 Meeting</button>
                <button class="btn zyka-filter-btn" data-filter="celebrate">🎉 Celebrate</button>
            </nav>
 
            <div class="zyka-booking-list">
 
                @if (Model == null || !Model.Any())
                {
                    <div class="text-center text-white">
                        <p>No bookings found.</p>
                    </div>
                }
                else
                {
                    foreach (var booking in Model)
                    {
                        <article class="zyka-card" data-category="@booking.Category?.ToLower()">
                            <div class="zyka-card-content">
                                <h5 class="zyka-card-name">
                                    @booking.CustomerName
                                </h5>
 
                                <p class="zyka-card-id">
                                    ID: <span>@booking.BookingCode</span>
                                </p>
 
                                <p class="zyka-card-info">
                                    @booking.Guests Members | @booking.TableType Table
                                </p>
                            </div>
 
                            <div class="zyka-card-status">
                                @if (booking.Status?.ToLower() == "completed")
                                {
                                    <span class="zyka-badge status-completed">Completed</span>
                                }
                                else if (booking.Status?.ToLower() == "upcoming")
                                {
                                    <span class="zyka-badge status-upcoming">Upcoming</span>
                                }
                                else if (booking.Status?.ToLower() == "cancelled")
                                {
                                    <span class="zyka-badge status-cancelled">Cancelled</span>
                                }
                                else
                                {
                                    <span class="zyka-badge status-upcoming">@booking.Status</span>
                                }
                            </div>
                        </article>
                    }
                }
 
            </div>
 
        </div>
    </div>
</div>
 
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const filters = document.querySelectorAll('.zyka-filter-btn');
            const cards = document.querySelectorAll('.zyka-card');
 
            filters.forEach(btn => {
                btn.addEventListener('click', function () {
                    filters.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
 
                    const category = this.getAttribute('data-filter');
 
                    cards.forEach(card => {
                        const cardCategory = card.getAttribute('data-category');
                        if (category === "all" || cardCategory === category) {
                            card.style.display = "flex";
                        } else {
                            card.style.display = "none";
                        }
                    });
                });
            });
        });
    </script>
}
 