@{
    ViewData["Title"] = "Support";
    Layout = "_Layout";
}

<div class="container py-5">
    <h2 class="mb-4">Customer Support</h2>

    <div class="card p-4 shadow-sm">
        <div class="mb-3">
            <label>Name</label>
            <input id="custName" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Phone</label>
            <input id="phone" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input id="email" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Booking ID (optional)</label>
            <input id="reservationId" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Your Query</label>
            <textarea id="query" class="form-control"></textarea>
        </div>

        <button id="submitTicket" class="btn btn-dark w-100">
            Submit Query
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/support.js"></script>
}

