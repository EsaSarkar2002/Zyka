@* Razor Page Header *@
@{
    ViewData["Title"] = "Booking";
    Layout = "_Layout";
}

@* CSS Link with versioning to prevent cache issues *@
<link rel="stylesheet" href="~/css/CustomerBooking.css" asp-append-version="true" />


<div style="background: url('@Url.Content("~/images/image background.jpg")');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
            width: 100%;
            margin: 0;
            padding: 0;">

    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="text-dark-green">Reserve Your Table</h1>
            <p class="text-muted">Complete the form below to book your dining experience</p>
        </div>

        <form id="bookingForm" class="mx-auto" style="max-width: 900px;">

            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <i class="bi bi-calendar3 text-warning fs-5 me-2"></i>
                        <h3 class="mb-0 text-dark-green">Select Booking Type</h3>
                    </div>

                    <div class="row g-3">
                        <div class="col-6 col-md-3 col-lg-4">
                            <div class="booking-type-card" data-type="date" data-seats="2" data-min="2" data-max="2">
                                <div class="booking-icon">
                                    <img src="~/images/Image1.jpg" alt="Dating" />
                                </div>
                                <p class="fw-bold text-dark-green mb-0">Dating</p>
                                <small class="text-muted">2 seats</small>
                            </div>
                        </div>

                        <div class="col-6 col-md-3 col-lg-4">
                            <div class="booking-type-card" data-type="family" data-seats="4" data-min="4" data-max="6">
                                <div class="booking-icon">
                                    <img src="~/images/Image family.jpg" alt="Family" />
                                </div>
                                <p class="fw-bold text-dark-green mb-0">Family</p>
                                <small class="text-muted">4-6 seats</small>
                            </div>
                        </div>

                        <div class="col-6 col-md-3 col-lg-4">
                            <div class="booking-type-card" data-type="meeting" data-seats="8" data-min="8" data-max="12">
                                <div class="booking-icon">
                                    <img src="~/images/Image meeting.jpg" alt="Meeting" />
                                </div>
                                <p class="fw-bold text-dark-green mb-0">Meeting</p>
                                <small class="text-muted">8-12 seats</small>
                            </div>
                        </div>

                        <div class="col-6 col-md-3 col-lg-4">
                            <div class="booking-type-card" data-type="party" data-seats="15" data-min="15" data-max="20">
                                <div class="booking-icon">
                                    <img src="~/images/Image party.jpg" alt="Party" />
                                </div>
                                <p class="fw-bold text-dark-green mb-0">Party</p>
                                <small class="text-muted">15-20 seats</small>
                            </div>
                        </div>
                    </div>

                    <div class="invalid-feedback d-block" id="typeError" style="display:none"></div>

                    <div class="mt-4" id="seatingSection" style="display:none;">
                        <label class="form-label fw-bold">Number of Guests (Editable)</label>
                        <input type="number" class="form-control w-auto" id="seatingCapacity" min="1" max="50" value="2">
                    </div>
                </div>
            </div>

            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <i class="bi bi-calendar-event text-warning fs-5 me-2"></i>
                        <h3 class="mb-0 text-dark-green">Select Date</h3>
                    </div>
                    <input type="date" class="form-control" id="bookingDate" required>
                    <div class="invalid-feedback" id="dateError" style="display:none"></div>
                </div>
            </div>

            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <i class="bi bi-clock text-warning fs-5 me-2"></i>
                        <h3 class="mb-0 text-dark-green">Select Time Slot</h3>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-black mb-3 border-bottom pb-1">Morning</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="time-slot btn" data-time="10:00 AM - 11:00 AM">10:00 AM - 11:00 AM</button>
                            <button type="button" class="time-slot btn" data-time="11:00 AM - 12:00 PM">11:00 AM - 12:00 PM</button>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-black mb-3 border-bottom pb-1">Afternoon</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="time-slot btn" data-time="12:00 PM - 1:00 PM">12:00 PM - 1:00 PM</button>
                            <button type="button" class="time-slot btn" data-time="1:00 PM - 2:00 PM">1:00 PM - 2:00 PM</button>
                            <button type="button" class="time-slot btn" data-time="2:00 PM - 3:00 PM">2:00 PM - 3:00 PM</button>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-black mb-3 border-bottom pb-1">Evening</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="time-slot btn" data-time="6:00 PM - 7:00 PM">6:00 PM - 7:00 PM</button>
                            <button type="button" class="time-slot btn" data-time="7:00 PM - 8:00 PM">7:00 PM - 8:00 PM</button>
                            <button type="button" class="time-slot btn" data-time="8:00 PM - 9:00 PM">8:00 PM - 9:00 PM</button>
                        </div>
                    </div>

                    <div class="invalid-feedback d-block" id="timeError" style="display:none"></div>
                </div>
            </div>

            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <i class="bi bi-person text-warning fs-5 me-2"></i>
                        <h3 class="mb-0 text-dark-green">Your Details</h3>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="customerName" class="form-label">Full Name *</label>
                            <input type="text" class="form-control" id="customerName" placeholder="Enter your full name" required>
                            <div class="invalid-feedback" id="nameError" style="display:none"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="mobileNumber" class="form-label"><i class="bi bi-phone"></i> Mobile Number *</label>
                            <input type="tel" class="form-control" id="mobileNumber" placeholder="10-digit mobile number" maxlength="10" required>
                            <div class="invalid-feedback" id="mobileError" style="display:none"></div>
                        </div>

                        <div class="col-md-6">
                            <label for="whatsappNumber" class="form-label"><i class="bi bi-whatsapp"></i> WhatsApp Number *</label>
                            <input type="tel" class="form-control" id="whatsappNumber" placeholder="10-digit WhatsApp number" maxlength="10" required>
                            <div class="invalid-feedback" id="whatsappError" style="display:none"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-5">
                <button type="submit" class="btn btn-gradient w-100 py-3 d-flex align-items-center justify-content-center text-white">
                    <span class="fw-bold text-black">Proceed to Payment</span>
                    <i class="bi bi-chevron-right ms-2"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Booking.js" asp-append-version="true"></script>
}