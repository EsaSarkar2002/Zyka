@{

ViewData["Title"] = "Book Your Table";

Layout = "_Layout";

}

@model List<Zyka.Models.TimeSlot>

    <div class="zyka-booking-page">
        <div class="container py-5">
            <div class="zyka-booking-header text-center mb-5">
                <h1 class="text-black fw-bold">Reserve Your Table</h1>
                <p class="text-black">Complete the form below to book your dining experience</p>
            </div>

            <form id="bookingForm" class="mx-auto zyka-form">

                <section class="zyka-booking-card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="zyka-section-title mb-4">
                            <i class="bi bi-calendar3"></i>
                            <h3>Select Booking Type</h3>
                        </div>

                        <div class="row g-3 justify-content-center">
                            <div class="col-6 col-md-3">
                                <div class="zyka-type-card" data-type="0" data-seats="2" data-min="2" data-max="2">
                                    <div class="zyka-type-img">
                                        <img src="~/images/Image1.jpg" alt="Dating" />
                                    </div>
                                    <div class="zyka-type-info">
                                        <span class="fw-bold d-block">Dating</span>
                                        <small >2 seats</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 col-md-3">
                                <div class="zyka-type-card" data-type="1" data-seats="4" data-min="4" data-max="6">
                                    <div class="zyka-type-img">
                                        <img src="~/images/Image family.jpg" alt="Family" />
                                    </div>
                                    <div class="zyka-type-info">
                                        <span class="fw-bold d-block">Family</span>
                                        <small>4-6 seats</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 col-md-3">
                                <div class="zyka-type-card" data-type="2" data-seats="8" data-min="8" data-max="12">
                                    <div class="zyka-type-img">
                                        <img src="~/images/Image meeting.jpg" alt="Meeting" />
                                    </div>
                                    <div class="zyka-type-info">
                                        <span class="fw-bold d-block">Meeting</span>
                                        <small >8-12 seats</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 col-md-3">
                                <div class="zyka-type-card" data-type="3" data-seats="15" data-min="15" data-max="20">
                                    <div class="zyka-type-img">
                                        <img src="~/images/Image party.jpg" alt="Party" />
                                    </div>
                                    <div class="zyka-type-info">
                                        <span class="fw-bold d-block">Celebration</span>
                                        <small>15-20 seats</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="invalid-feedback d-block" id="typeError" style="display:none"></div>
                        <div id="seatingSection" class="mt-4 text-center" style="display:none;">
                            <label class="form-label fw-bold">Number of Guests
                            </label>
                            <input type="number" class="form-control mx-auto w-auto text-center" id="seatingCapacity"
                                >
                        </div>
                    </div>
                </section>

                <section class="card zyka-booking-card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="zyka-section-title mb-3">
                            <i class="bi bi-calendar-event"></i>
                            <h3>Select Date</h3>
                        </div>
                        <input type="date" class="form-control zyka-input" id="bookingDate" onkeydown="return false" required>
                    </div>
                </section>

                <section class="card zyka-booking-card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="zyka-section-title mb-4">
                            <i class="bi bi-clock"></i>
                            <h3>Select Time Slot</h3>
                        </div>

                        <div class="zyka-time-group mb-4">
                            <h6 class="zyka-time-label">Morning</h6>
                            <div class="d-flex flex-wrap gap-2">

                                @foreach(var slot in Model.Where(x=>x.Period==Zyka.Models.Enums.TimeSlotPeriod.Morning))

                                {
                                <button type="button" class="zyka-time-btn"
                                    data-timeslotid="@slot.TimeSlotId">@slot.DisplayText</button>

                                }
                            </div>
                        </div>

                        <div class="zyka-time-group mb-4">
                            <h6 class="zyka-time-label">Afternoon</h6>
                            <div class="d-flex flex-wrap gap-2">

                                @foreach(var slot in
                                Model.Where(x=>x.Period==Zyka.Models.Enums.TimeSlotPeriod.Afternoon))

                                {
                                <button type="button" class="zyka-time-btn"
                                    data-timeslotid="@slot.TimeSlotId">@slot.DisplayText</button>

                                }
                            </div>
                        </div>

                        <div class="zyka-time-group mb-4">
                            <h6 class="zyka-time-label">Evening</h6>
                            <div class="d-flex flex-wrap gap-2">

                                @foreach(var slot in Model.Where(x=>x.Period==Zyka.Models.Enums.TimeSlotPeriod.Evening))

                                {
                                <button type="button" class="zyka-time-btn"
                                    data-timeslotid="@slot.TimeSlotId">@slot.DisplayText</button>

                                }
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card zyka-booking-card shadow-sm mb-5">
                    <div class="card-body p-4">
                        <div class="zyka-section-title mb-4">
                            <i class="bi bi-person"></i>
                            <h3>Your Details</h3>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Full Name *</label>
                                <input type="text" class="form-control zyka-input" value="@(ViewBag.UserName)" id="customerName" required>
                            </div>
                            <div class="row customer-numbers">
    <div class="col-md-6 mb-3">
        <label class="form-label">Mobile Number *</label>
        <input type="number" class="form-control zyka-input" id="mobileNumber" 
               oninput="if (this.value.length > 10) this.value = this.value.slice(0, 10);" required>
    </div>


    <div class="col-md-6 mb-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="sameAsMobile">
            <label class="form-check-label" for="sameAsMobile" style="font-size: 0.9rem;">
                WhatsApp number is same as mobile
            </label>
        </div>
        <label class="form-label">WhatsApp Number *</label>
        <input type="number" class="form-control zyka-input" id="whatsappNumber" 
               oninput="if (this.value.length > 10) this.value = this.value.slice(0, 10);" required>
    </div>
</div>
                        </div>
                    </div>
                </section>

                <button type="submit" class="btn zyka-btn-submit w-100 py-3 mb-5">

                    Proceed to Payment <i class="bi bi-chevron-right ms-2"></i>
                </button>
            </form>
        </div>
    </div>

    @section Scripts{

    @*
    <script src="~/js/Booking.js" asp-append-version="true"></script> *@

    @*
    <script>const getAvailableSlotUrl = '@Url.Action("GetAvailableTimeSlots","Customer")';</script> *@

    }