@if (User?.Identity?.IsAuthenticated == false)
{
    <div id="loginOverlay" class="login-overlay">
        <div class="login-popup">
            <div class="login-popup-left">
                <img src="~/images/Restaurant interior.jpg" alt="Welcome" class="login-left-image">
                <div class="login-left-overlay">
                    <div class="login-left-content">
                        <h3>Welcome Back</h3>
                        <p>Please login using your personal information<br />to stay connected with Zyka.</p>
                    </div>
                </div>
            </div>

            <div class="login-popup-right">
                <span class="login-popup-close text-black" onclick="closeLoginPopup()">&times;</span>

                <div class="login-logo">
                    <img src="~/images/ZYKA_logo_transparent.png" alt="Zyka Logo">
                </div>

                @* Display Error/Success Messages *@
                @if (TempData["LoginError"] != null)
                {
                    <div class="alert alert-danger p-2" style="font-size: 0.8rem;">@TempData["LoginError"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger p-2" style="font-size: 0.8rem;">@TempData["ErrorMessage"]</div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success p-2" style="font-size: 0.8rem;">@TempData["SuccessMessage"]</div>
                }

                @* LOGIN FORM: Hides if "ShowSignup" is set *@
                <form id="loginForm" class="login-form" method="post" action="/Account/Login"
                      style="@(TempData["ShowSignup"] != null ? "display:none;" : "display:block;")">
                    
                    <div class="input-group-custom">
                        <input type="email" placeholder="Email address" name="Email" required />
                    </div>
                    <div class="input-group-custom">
                        <input type="password" placeholder="Password" name="Password" required />
                    </div>
                    <div class="text-end mb-3">
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>
                    <button type="submit" class="login-btn">Log In</button>
                    <p class="signup-text">
                        Don’t have an account? <a href="#" onclick="showSignup()">Signup</a>
                    </p>
                </form>

                @* SIGNUP FORM: Shows if "ShowSignup" is set *@
                <form method="post" action="/Account/Register" id="signupForm" class="login-form"
                      style="@(TempData["ShowSignup"] != null ? "display:block;" : "display:none;")">
                    
                    <div class="input-group-custom">
                        <input type="text" name="UserName" placeholder="Full name" required />
                    </div>
                    <div class="input-group-custom">
                        <input type="email" name="Email" placeholder="Email address" required />
                    </div>
                    <div class="input-group-custom">
                        <input type="password" name="Password" placeholder="Password" required />
                    </div>
                    <div class="input-group-custom">
                        <input type="password" name="ConfirmPassword" placeholder="Confirm password" required />
                    </div>
                    <button type="submit" class="login-btn">Sign Up</button>
                    <p class="signup-text">
                        Already have an account? <a href="#" onclick="showLogin()">Login</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
}