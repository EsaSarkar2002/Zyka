<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zyka</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/adminDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Zyka.styles.css" asp-append-version="true" />
</head>
<body>
    
    
    <div class="admin-sidebar">
        <div class="sidebar-header">
            <h2 class="brand-title">ZYKA</h2>
            <p class="text-white-50 mb-0">Admin Panel</p>
        </div>
        
        <nav class="nav flex-column py-3">
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString()=="Dashboard"?"active":"")" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString()=="Tables"?"active":"")" asp-controller="Admin" asp-action="TableCategories">
                <i class="bi bi-grid-3x3"></i> Tables
            </a>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString()=="Bookings"?"active":"")" asp-controller="Admin" asp-action="Bookings">
                <i class="bi bi-calendar-check"></i> Bookings
            </a>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString()=="History"?"active":"")" asp-controller="Admin" asp-action="History">
                <i class="bi bi-clock-history"></i> History
            </a>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString()==""?"active":"")" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-chat-square-text"></i> Restaurant Closed Message
            </a>
        </nav>

        <div class="p-3 mt-auto" style="position: absolute; bottom: 0; width: 100%; border-top: 1px solid rgba(255,255,255,0.1);"> @* <div class="d-flex align-items-center justify-content-between bg-white bg-opacity-10 rounded p-3"> *@
                <button class="btn  text-white p-0 d-flex text-decoration-none align-items-center justify-content-between bg-white bg-opacity-10 rounded p-3" id="logoutBtn">
                    <i class="bi bi-box-arrow-left fs-5"></i>
                    <p class="mb-0 text-white px-5 ">Logout</p>
                </button>
                </div>
            </div>
        </div>
    </div>

    @* <div class="container"> *@

        <main role="main" class="pb-3">
            <div>Master Layout </div>
            @RenderBody()
        </main>

    @* </div> *@
    @* <footer class="border-top footer text-muted">
        <div class="container ">
            &copy; 2025 - Zyka - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
