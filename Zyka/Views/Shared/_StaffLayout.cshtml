<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Staff Portal</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/assets/css/staff.css">
    <link rel="stylesheet" href="~/css/StaffLayout.css">
</head>

<body>
    <aside class="sidebar">
        <div class="sidebar-brand">
            <h4>Restaurant Manager</h4>
            <p>Staff Portal</p>
        </div>
        <nav>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/Staff/Dashboard" class="nav-link-custom">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Staff/Booking" class="nav-link-custom">
                        <i class="bi bi-calendar-check"></i>
                        <span>Bookings</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Staff/Table" class="nav-link-custom">
                        <i class="bi bi-grid-3x3-gap"></i>
                        <span>Tables</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Staff/Support" class="nav-link-custom">
                        <i class="bi bi-question-circle"></i>
                        <span>Support</span>
                    </a>
                </li>
            </ul>

            <form class="p-3 mt-auto" method="post" action="/Account/Logout"
                style="position: absolute; bottom: 0; width: 100%; border-top: 1px solid rgba(255,255,255,0.1);">
                <button type="submit"
                    class="btn  text-white p-0 d-flex text-decoration-none align-items-center justify-content-between bg-white bg-opacity-10 rounded p-3"
                    id="logoutBtn">
                    <i class="bi bi-box-arrow-left fs-5"></i>
                    <p class="mb-0 text-white px-5 ">Logout</p>
                </button>
            </form>
        </nav>
    </aside>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/staff.js"></script>
</body>

</html>