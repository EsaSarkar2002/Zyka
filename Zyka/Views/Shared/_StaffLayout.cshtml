<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@ViewData["Title"] - Staff Portal</title>
<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<!-- Custom CSS -->
<link rel="stylesheet" href="~/assets/css/staff.css">
<link rel="stylesheet" href="~/css/StaffLayout.css">
</head>
<body>
<aside class="sidebar">
<div class="sidebar-brand">
<h4>Restaurant Manager</h4>
<p>Staff Portal</p>
</div>
<nav>
<ul class="nav-menu">
<li class="nav-item">
<a href="/Staff/Dashboard" class="nav-link-custom">
<i class="bi bi-speedometer2"></i>
<span>Dashboard</span>
</a>
</li>
<li class="nav-item">
<a href="/Staff/Booking" class="nav-link-custom">
<i class="bi bi-calendar-check"></i>
<span>Bookings</span>
</a>
</li>
<li class="nav-item">
<a href="/Staff/Table" class="nav-link-custom">
<i class="bi bi-grid-3x3-gap"></i>
<span>Tables</span>
</a>
</li>
<li class="nav-item">
<a href="/Staff/Support" class="nav-link-custom">
<i class="bi bi-question-circle"></i>
<span>Support</span>
</a>
</li>
</ul>
 
        <div class="nav-bottom">
<ul class="nav-menu">
<li class="nav-item">
<a href="#" class="nav-link-custom" id="logoutBtn">
<i class="bi bi-box-arrow-left"></i>
<span>Logout</span>
</a>
</li>
</ul>
</div>
</nav>
</aside>
 
    <main role="main" class="pb-3">
        @RenderBody()
</main>
 
    <!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/assets/js/staff.js"></script>
</body>
</html>