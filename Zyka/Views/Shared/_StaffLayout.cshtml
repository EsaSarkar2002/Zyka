<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Staff Portal</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <link rel="stylesheet" href="~/css/StaffBooking.css" asp-append-version="true" />
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-brand">
            <img src="~/images/Zka_logo_transparent.png" alt="ZYKA Logo" class="brand-logo mb-2">
            <p>Staff Portal</p>
        </div>
        
        <nav class="flex-grow-1">
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="/Staff/Dashboard" class="nav-link-custom">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Staff/Booking" class="nav-link-custom">
                        <i class="bi bi-calendar-check"></i>
                        <span>Bookings</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Staff/Table" class="nav-link-custom">
                        <i class="bi bi-grid-3x3-gap"></i>
                        <span>Tables</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Staff/Support" class="nav-link-custom">
                        <i class="bi bi-question-circle"></i>
                        <span>Support</span>
                    </a>
                </li>
            </ul>
        </nav>

        <form class="p-3" method="post" action="/Account/Logout" style="border-top: 1px solid rgba(255,255,255,0.1);">
            <button type="submit" class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center gap-2" id="logoutBtn">
                <i class="bi bi-box-arrow-left"></i>
                <span>Logout</span>
            </button>
        </form>
    </aside>

    <main role="main">
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/staff.js" asp-append-version="true"></script>
</body>
</html>