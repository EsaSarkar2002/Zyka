@{
    ViewData["Title"] = "Zyka | Restaurant table Booking";
}

<main>
    <section class="hero-section">
        <img src="~/images/food123.jpg" alt="Zyka food background" class="hero-bg-image">
        <div class="hero-overlay"></div>
        <div class="hero-inner" id="hero-content">
            <h1 class="hero-brand">ZYKA</h1>
            <p class="hero-tagline">Food made with love</p>
            <p class="hero-sub">Craving something?</p>
            <a href="/Customer/Booking" class="btn btn-cta">

                Book Now
            </a>
            <div class="scroll-hint mt-4">
                <span>Scroll for more</span>
                <a href="#feed" class="scroll-arrow">
                    <span class="scroll-arrow-icon">&darr;</span>
                </a>
            </div>
        </div>
    </section>

    <!-- FEED SECTION (DATE, FAMILY, CELEBRITY, PROFESSIONAL, etc.) -->
    <section id="feed" class="feed-wrapper container">
        <div class="feed-header">
            <h2>Moments at Zyka</h2>
            <p>From first dates to big wins at work, explore how Zyka becomes part of every story.</p>
        </div>
        <!-- Date image left -->
        <article class="feed-item">
            <div class="row g-0 align-items-stretch">
                <div class="col-md-5">
                    <img src="~/images/dateimage2.jpg" class="feed-image" alt="Romantic date setup at Zyka">
                </div>
                <div class="col-md-7">
                    <div class="feed-body">
                        <div class="feed-label">Date Night</div>
                        <h3 class="feed-title h5">Cozy corners made for two</h3>
                        <p class="feed-text">
                            Reserve intimate seating with soft music, warm lighting, and a curated menu
                            designed for long conversations and slow, memorable dinners.
                        </p>
                    </div>
                </div>
            </div>
        </article>
        <!-- Text row -->
        <section class="feed-text-row">
            <p>
                Whether it’s your first visit or your fiftieth, Zyka keeps your table ready,
                your stories flowing, and your plates full of comfort.
            </p>
        </section>
        <!-- Family image right -->
        <article class="feed-item">
            <div class="row g-0 align-items-stretch">
                <div class="col-md-7 order-2 order-md-1">
                    <div class="feed-body">
                        <div class="feed-label">Family Time</div>
                        <h3 class="feed-title h5">Room for every laugh</h3>
                        <p class="feed-text">
                            Big tables, sharable platters, and kid-friendly favorites make sure
                            everyone from grandparents to toddlers feels right at home.
                        </p>
                    </div>
                </div>
                <div class="col-md-5 order-1 order-md-2">
                    <img src="~/images/shared image (4).jpg" class="feed-image"
                         alt="Family enjoying dinner together at Zyka">
                </div>
            </div>
        </article>
        <!-- Celebrity image left -->
        <article class="feed-item">
            <div class="row g-0 align-items-stretch">
                <div class="col-md-5">
                    <img src="~/images/celebrationimage1.jpg" class="feed-image" alt="Celebrity guest at Zyka">
                </div>
                <div class="col-md-7">
                    <div class="feed-body">
                        <div class="feed-label">Celebrity Visits</div>
                        <h3 class="feed-title h5">Where stars feel at home</h3>
                        <p class="feed-text">
                            Artists, creators, and public figures choose Zyka for its balance of
                            privacy, warmth, and unforgettable flavors crafted with care.
                        </p>
                    </div>
                </div>
            </div>
        </article>
        <!-- Professional image right -->
        <article class="feed-item">
            <div class="row g-0 align-items-stretch">
                <div class="col-md-7">
                    <div class="feed-body">
                        <div class="feed-label">Professional Meets</div>
                        <h3 class="feed-title h5">Host your next big idea</h3>
                        <p class="feed-text">
                            Private seating, reliable service, and custom menus make Zyka a natural
                            choice for client lunches, team dinners, and networking evenings.
                        </p>
                    </div>
                </div>
                <div class="col-md-5">
                    <img src="~/images/shared image (2).jpg" class="feed-image"
                         alt="Professionals having a discussion over dinner">
                </div>
            </div>
        </article>
        <!-- Event image left -->
        <article class="feed-item">
            <div class="row g-0 align-items-stretch">
                <div class="col-md-5">
                    <img src="~/images/shared image (5).jpg" class="feed-image"
                         alt="Celebration event at Zyka with lights and décor">
                </div>
                <div class="col-md-7">
                    <div class="feed-body">
                        <div class="feed-label">Events</div>
                        <h3 class="feed-title h5">Celebrate every milestone</h3>
                        <p class="feed-text">
                            Birthdays, anniversaries, and special occasions become effortless with
                            custom décor, playlists, and menus crafted around your story.
                        </p>
                    </div>
                </div>
            </div>
        </article>
        <!-- Food image right -->
        <article class="feed-item">
            <div class="row g-0 align-items-stretch">
                <!-- Text Left -->
                <div class="col-md-7">
                    <div class="feed-body">
                        <div class="feed-label">Signature Dishes</div>
                        <h3 class="feed-title h5">Plates you’ll remember</h3>
                        <p class="feed-text">
                            From slow-cooked curries to sizzling grills, each dish is created with fresh
                            ingredients,
                            bold flavors, and a touch of creativity. Here are some of our best-sellers.
                        </p>
                    </div>
                </div>
                <!-- Food Carousel Right -->
                <div class="col-md-5">
                    <!-- 👇 added `carousel-fade` + autoplay + interval -->
                    <div id="foodCarousel" class="carousel slide carousel-fade h-100" data-bs-ride="carousel"
                         data-bs-interval="2600">
                        <div class="carousel-inner h-100">
                            <!-- Image 1 -->
                            <div class="carousel-item active">
                                <img src="~/images/Image.jpg" class="d-block w-100 feed-image" alt="Food item 1">
                            </div>
                            <!-- Image 2 -->
                            <div class="carousel-item">
                                <img src="~/images/Image (1).jpg" class="d-block w-100 feed-image" alt="Food item 2">
                            </div>
                            <!-- Image 3 -->
                            <div class="carousel-item">
                                <img src="~/images/Image (2).jpg" class="d-block w-100 feed-image" alt="Food item 3">
                            </div>
                            <!-- Image 4 -->
                            <div class="carousel-item">
                                <img src="~/images/Image (3).jpg" class="d-block w-100 feed-image" alt="Food item 4">
                            </div>
                            <!-- Image 5 -->
                            <div class="carousel-item">
                                <img src="~/images/Image (4).jpg" class="d-block w-100 feed-image" alt="Food item 5">
                            </div>
                            <!-- Image 6 -->
                            <div class="carousel-item">
                                <img src="~/images/Image (5).jpg" class="d-block w-100 feed-image" alt="Food item 6">
                            </div>
                            <!-- Image 7 -->
                            <div class="carousel-item">
                                <img src="~/images/Image (6).jpg" class="d-block w-100 feed-image" alt="Food item 7">
                            </div>
                            <!-- Image 8 -->
                            <div class="carousel-item">
                                <img src="~/images/Image (7).jpg" class="d-block w-100 feed-image" alt="Food item 8">
                            </div>
                            <!-- Image 9 -->
                            <div class="carousel-item">
                                <img src="~/images/Image (3).jpg" class="d-block w-100 feed-image" alt="Food item 9">
                            </div>
                            <!-- Image 10 -->
                            <div class="carousel-item">
                                <img src="~/images/Image (8).jpg" class="d-block w-100 feed-image" alt="Food item 10">
                            </div>
                        </div>
                        <!-- Controls -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#foodCarousel"
                                data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#foodCarousel"
                                data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
        </article>
        <!-- Review image right -->
        <article class="feed-item">
            <div class="row g-0 align-items-stretch">
                <div class="col-md-7">
                    <div class="feed-body">
                        <div class="feed-label">Reviews</div>
                        <h3 class="feed-title h5">Loved by our guests</h3>
                        <p class="feed-text">
                            Showcase real feedback, ratings, and testimonials to highlight why
                            Zyka is the go-to place for comfort, taste, and atmosphere.
                        </p>
                    </div>
                </div>
                <div class="col-md-5">
                    <img src="~/images/guests.jpg" class="feed-image"
                         alt="Customer giving a positive rating on a device">
                </div>
            </div>
        </article>
    </section>
  

</main>